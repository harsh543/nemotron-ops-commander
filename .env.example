# Application
APP_ENV=development
APP_NAME=nemotron-ops-commander
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=change-me-in-production

# Nebius Token Factory (hosted inference — set as an HF Space secret in prod,
# never commit a real value here). Get the key from tokenfactory.nebius.com.
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# RevenueCat (Subscriptions track) — app.revenuecat.com.
# PUBLIC_API_KEY is safe client-side (embedded in the Pro tab's purchase
# widget); SECRET_KEY is server-only, used for entitlement checks.
REVENUECAT_PUBLIC_API_KEY=
REVENUECAT_SECRET_KEY=
REVENUECAT_ENTITLEMENT=pro
REVENUECAT_PACKAGE_ID=pro_monthly

# Nemotron Model
NEMOTRON_MODEL_NAME=nvidia/Nemotron-Mini-4B-Instruct
NEMOTRON_DEVICE=cuda
NEMOTRON_MAX_NEW_TOKENS=2048
NEMOTRON_TEMPERATURE=0.7
NEMOTRON_TOP_P=0.9
NEMOTRON_USE_SGLANG=true

# ChromaDB (embedded, no external server needed)
CHROMA_PERSIST_DIR=./chroma_storage
CHROMA_COLLECTION=incidents

# Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
PROMETHEUS_PORT=9000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
